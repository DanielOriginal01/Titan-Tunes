POSTGRES_DB=titan_tune_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# -- OAuth2 Google -----------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -- pgAdmin (interface web base de donnees) ---------------------------------
PGADMIN_EMAIL=admin@titan-tune.com
PGADMIN_PASSWORD=admin

# -- Configuration SMTP ------------------------------------------------------
# Option A : Mailtrap (test gratuit — https://mailtrap.io)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=no-reply@titan-tune.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Option B : Gmail
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password-gmail
# MAIL_FROM=your-email@gmail.com
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true

# URL de base de l'API
APP_BASE_URL=http://localhost:8080
