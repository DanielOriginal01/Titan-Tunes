{
  "info": {
    "name": "Titan Tunes API — Tests Complets",
    "description": "Collection de tests pour tous les endpoints de l'API Titan Tunes. Inclut les vérifications d'authentification, d'ownership et de rôles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8080/api/v1" },
    { "key": "admin_token",   "value": "" },
    { "key": "artiste_token", "value": "" },
    { "key": "auditeur_token","value": "" },
    { "key": "artiste_id",    "value": "" },
    { "key": "auditeur_id",   "value": "" },
    { "key": "chanson_id",    "value": "" },
    { "key": "playlist_id",   "value": "" }
  ],
  "item": [

    {
      "name": "1. AUTHENTIFICATION",
      "item": [
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token présent', () => { const d = pm.response.json().data; pm.expect(d.token).to.be.a('string'); pm.collectionVariables.set('admin_token', d.token); pm.collectionVariables.set('auditeur_id', d.id); });",
            "pm.test('Rôle ADMIN', () => pm.expect(pm.response.json().data.role).to.eql('ROLE_ADMIN'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOuUsername\": \"admin@titan.com\", \"password\": \"titansupadmin@2005\"}" }
          }
        },
        {
          "name": "Login Artiste (Kofi Mensah)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token présent + stocké', () => { const d = pm.response.json().data; pm.expect(d.token).to.be.a('string'); pm.collectionVariables.set('artiste_token', d.token); pm.collectionVariables.set('artiste_id', d.id); });",
            "pm.test('Rôle ARTISTE', () => pm.expect(pm.response.json().data.role).to.eql('ROLE_ARTISTE'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOuUsername\": \"kofi.mensah@music.tg\", \"password\": \"Artiste@2026!\"}" }
          }
        },
        {
          "name": "Login Auditeur (Amina)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token présent + stocké', () => { const d = pm.response.json().data; pm.expect(d.token).to.be.a('string'); pm.collectionVariables.set('auditeur_token', d.token); pm.collectionVariables.set('auditeur_id', d.id); });",
            "pm.test('Rôle AUDITEUR', () => pm.expect(pm.response.json().data.role).to.eql('ROLE_AUDITEUR'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOuUsername\": \"amina.koffi@gmail.com\", \"password\": \"Auditeur@2026!\"}" }
          }
        },
        {
          "name": "Inscription AUDITEUR",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Inscription réussie', () => pm.expect(pm.response.json().success).to.be.true);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "raw", "raw": "{\"username\": \"testuser99\", \"email\": \"testuser99@gmail.com\", \"password\": \"Test@12345\", \"telephone\": \"+22899000099\", \"role\": \"ROLE_AUDITEUR\"}" }
          }
        },
        {
          "name": "[SÉCURITÉ] Inscription ADMIN doit être rejetée (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 — inscription admin interdite', () => pm.response.to.have.status(400));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "raw", "raw": "{\"username\": \"hackeradmin\", \"email\": \"hacker@evil.com\", \"password\": \"hacked123\", \"telephone\": \"+0000000\", \"role\": \"ROLE_ADMIN\"}" }
          }
        },
        {
          "name": "[SÉCURITÉ] Login mauvais mot de passe (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 — mauvais credentials', () => pm.response.to.have.status(401));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"emailOuUsername\": \"admin@titan.com\", \"password\": \"mauvaismdp\"}" }
          }
        }
      ]
    },

    {
      "name": "2. ROUTES PUBLIQUES (sans token)",
      "item": [
        {
          "name": "GET Chansons — public",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 sans token', () => pm.response.to.have.status(200));",
            "pm.test('Liste non vide', () => pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty);",
            "if (pm.response.json().data.length > 0) { pm.collectionVariables.set('chanson_id', pm.response.json().data[0].id); }"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/chansons" }
        },
        {
          "name": "GET Tendances — public",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Chansons triées par écoutes', () => { const data = pm.response.json().data; pm.expect(data).to.be.an('array'); if (data.length > 1) { pm.expect(data[0].nbEcoutes).to.be.gte(data[1].nbEcoutes); } });"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/chansons/tendances" }
        },
        {
          "name": "GET Recherche — public",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Résultats de recherche présents', () => { const data = pm.response.json().data; pm.expect(data).to.have.property('chansons'); pm.expect(data).to.have.property('artistes'); });"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/search?q=kofi" }
        },
        {
          "name": "GET Artistes — public",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/artistes" }
        },
        {
          "name": "GET Bannières actives — public",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/bannieres/actives" }
        },
        {
          "name": "[SÉCURITÉ] GET Playlists sans token (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 sans token', () => pm.response.to.have.status(401));"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/playlists/auditeur/1" }
        },
        {
          "name": "[SÉCURITÉ] GET Admin sans token (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 sans token', () => pm.response.to.have.status(401));"
          ], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/admin/utilisateurs" }
        }
      ]
    },

