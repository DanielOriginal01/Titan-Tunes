          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{artiste_token}}" }],
            "url": "{{base_url}}/artistes/9999/dashboard"
          }
        },
        {
          "name": "[SÉCURITÉ] Modifier profil d'un AUTRE artiste (403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 — modification profil étranger refusée', () => pm.response.to.have.status(403));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{artiste_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/artistes/9999",
            "body": { "mode": "raw", "raw": "{\"bio\": \"J'essaie de modifier le profil d'un autre\"}" }
