          "name": "[SÉCURITÉ] Dashboard d'un AUTRE artiste (403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 — accès dashboard étranger refusé', () => pm.response.to.have.status(403));"
